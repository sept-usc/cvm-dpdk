From 6b95d96b3f349c95c5defdffe956b0d2c0d71ce8 Mon Sep 17 00:00:00 2001
From: keke1022 <keke83space@gmail.com>
Date: Thu, 22 Oct 2026 03:49:22 -0700
Subject: [PATCH] crypto/virtio: use IOVA for split used ring in vDPA

---
 drivers/crypto/virtio/virtio_user/virtio_user_dev.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/crypto/virtio/virtio_user/virtio_user_dev.c b/drivers/crypto/virtio/virtio_user/virtio_user_dev.c
index c8478d7..ba3b525 100644
--- a/drivers/crypto/virtio/virtio_user/virtio_user_dev.c
+++ b/drivers/crypto/virtio/virtio_user/virtio_user_dev.c
@@ -151,8 +151,8 @@ virtio_user_kick_queue(struct virtio_user_dev *dev, uint32_t queue_sel)
 	} else {
 		desc_addr = vring->desc_iova;
 		avail_addr = desc_addr + vring->num * sizeof(struct vring_desc);
-		used_addr = RTE_ALIGN_CEIL((uintptr_t)(&vring->avail->ring[vring->num]),
-					VIRTIO_VRING_ALIGN);
+		used_addr = desc_addr + (uintptr_t)vring->used -
+				(uintptr_t)vring->desc;
 
 		addr.desc_user_addr = desc_addr;
 		addr.avail_user_addr = avail_addr;
-- 
2.51.0

