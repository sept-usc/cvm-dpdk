From 63753b087ef993c1dee265d64b87d18d5d8083be Mon Sep 17 00:00:00 2001
From: keke1022 <keke83space@gmail.com>
Date: Thu, 22 Oct 2026 03:23:35 -0700
Subject: [PATCH] crypto/virtio: propagate rejected symmetric session requests

---
 drivers/crypto/virtio/virtio_cryptodev.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/crypto/virtio/virtio_cryptodev.c b/drivers/crypto/virtio/virtio_cryptodev.c
index 1b52809..4a79fc0 100644
--- a/drivers/crypto/virtio/virtio_cryptodev.c
+++ b/drivers/crypto/virtio/virtio_cryptodev.c
@@ -1436,6 +1436,7 @@ virtio_crypto_sym_configure_session(
 		VIRTIO_CRYPTO_SESSION_LOG_ERR("Something wrong on backend! "
 				"status=%u, session_id=%" PRIu64 "",
 				input->status, input->session_id);
+		ret = -EIO;
 		goto error_out;
 	} else {
 		session->session_id = input->session_id;
